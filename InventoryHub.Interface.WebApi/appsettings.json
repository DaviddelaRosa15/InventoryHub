{
  "InitialRun": false,
  "UseInMemoryDatabase": false,
  "ConnectionStrings": {
    "PostgreSQL": "%POSTGRESQL%",
    "IdentityDB": "%IdentityDB%"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JWTSettings": {
    "Key": "%JWTKEY%",
    "Issuer": "CodeIdentity",
    "Audience": "Base",
    "DurationInMinutes": 300
  },
  "RefreshJWTSettings": {
    "Key": "%REFRESHKEY%",
    "Issuer": "CodeIdentity",
    "Audience": "Base",
    "DurationInMinutes": 1440
  }
}
